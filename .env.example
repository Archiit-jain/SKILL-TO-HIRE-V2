# Copy to .env and adjust. Never commit .env.

# development | production | test
NODE_ENV=development

# API server (the Vite dev server on :5173 proxies /api here)
HOST=127.0.0.1
API_PORT=4000
# In production (NODE_ENV=production) PORT takes precedence, as injected by most hosts.
# PORT=8080

# The URL users open in the browser. Used by the CSRF origin check and for links in verification emails.
# On Vercel it defaults to https://<project production domain>.
APP_ORIGIN=http://localhost:5173

# REQUIRED in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a secret is generated automatically in server/data/.dev-jwt-secret
JWT_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=168

# SQLite file location (default: server/data/skill2hire.db)
# DATABASE_PATH=

# Set to true only when running behind a reverse proxy (nginx, Render, Railway...) so rate limits see real client IPs
TRUST_PROXY=false

# Optional: Gemini phrasing for the Career Assistant. BOTH must be set, otherwise the rule-based assistant is used.
# Pick the model name yourself from Google's current model list - no default is assumed.
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Sign in with Google (optional) -----------------------------------------------------------------------------
# OAuth 2.0 "Web application" client ID from Google Cloud Console. Leave empty to hide the Google button.
# Authorised JavaScript origins must include http://localhost:5173 (dev) and your Vercel URL. See docs/SETUP.md.
GOOGLE_CLIENT_ID=

# ---- Verification emails (Gmail SMTP) -----------------------------------------------------------------------------
# Without these, development prints verification links to the server console, and production disables email sign-up
# (Google sign-in still works). SMTP_PASS must be a Google *App Password* (16 characters), not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address shown to users (defaults to SMTP_USER). With Gmail it must be your address or a verified alias.
EMAIL_FROM=
# How long verification links stay valid
EMAIL_VERIFICATION_TTL_HOURS=24
# Reject email domains that have no mail server (DNS MX/A lookup)
EMAIL_DNS_CHECK=true
