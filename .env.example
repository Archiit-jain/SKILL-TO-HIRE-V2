# Copy to .env and adjust. Never commit .env.

# development | production | test
NODE_ENV=development

# API server (the Vite dev server on :5173 proxies /api here)
HOST=127.0.0.1
API_PORT=4000
# In production (NODE_ENV=production) PORT takes precedence, as injected by most hosts.
# PORT=8080

# The URL users open in the browser. Used by the CSRF origin check.
APP_ORIGIN=http://localhost:5173

# REQUIRED in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a secret is generated automatically in server/data/.dev-jwt-secret
JWT_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=168

# SQLite file location (default: server/data/skill2hire.db)
# DATABASE_PATH=

# Set to true only when running behind a reverse proxy (nginx, Render, Railway...) so rate limits see real client IPs
TRUST_PROXY=false

# Optional: Gemini phrasing for the Career Assistant. BOTH must be set, otherwise the rule-based assistant is used.
# Pick the model name yourself from Google's current model list - no default is assumed.
GEMINI_API_KEY=
GEMINI_MODEL=
