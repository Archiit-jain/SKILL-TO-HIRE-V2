{
  "name": "skill2hire-ai-resume-analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "Skill2Hire - AI resume vs job-description analyzer (React + Express + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@napi-rs/canvas": "0.1.80",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.45.0",
    "mailchecker": "6.0.21",
    "mammoth": "1.12.3",
    "multer": "2.3.0",
    "nodemailer": "10.0.9",
    "pdf-parse": "2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "postcss": "8.5.28",
    "supertest": "7.2.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
